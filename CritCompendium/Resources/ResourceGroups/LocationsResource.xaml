<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:selectors="clr-namespace:CritCompendium.TemplateSelectors">
   <ResourceDictionary.MergedDictionaries>
      <ResourceDictionary Source="../ItemTemplates/LocationViewTemplate.xaml"/>
      <ResourceDictionary Source="../ItemTemplates/LocationEditTemplate.xaml"/>
      <ResourceDictionary Source="../ItemTemplates/LocationDungeonTemplate.xaml"/>
      <ResourceDictionary Source="../ItemTemplates/LocationSettlementTemplate.xaml"/>
      <ResourceDictionary Source="../ItemTemplates/LocationWildernessTemplate.xaml"/>
      <ResourceDictionary Source="../ItemTemplates/LocationBuildingTemplate.xaml"/>
   </ResourceDictionary.MergedDictionaries>

   <selectors:LocationDetailsTemplateSelector x:Key="_locationDetailsTemplateSelector"
                                              DungeonTemplate="{StaticResource _locationDungeonDetailsTemplate}"
                                              SettlementTemplate="{StaticResource _locationSettlementDetailsTemplate}"
                                              WildernessTemplate="{StaticResource _locationWildernessDetailsTemplate}" />
</ResourceDictionary>