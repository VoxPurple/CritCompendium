<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ovm="clr-namespace:CritCompendium.ViewModels.ObjectViewModels" >
   <ResourceDictionary.MergedDictionaries>
      <ResourceDictionary Source="LocationBuildingTemplate.xaml"/>
   </ResourceDictionary.MergedDictionaries>

   <DataTemplate x:Key="_locationDungeonDetailsTemplate"
                 DataType="{x:Type ovm:LocationViewModel}">
      <StackPanel>
         <WrapPanel>
            <StackPanel Width="225"
                        Margin="0,0,10,0"
                        HorizontalAlignment="Left">
               <TextBlock Margin="0,10,0,0"
                          FontSize="10"
                          Foreground="{DynamicResource _secondaryTextBrush}"
                          Text="Location Type"/>
               <TextBlock Margin="0,0,0,10"
                          Foreground="{DynamicResource _primaryTextBrush}"
                          Text="{Binding LocationType}"
                          TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel Width="225"
                        Margin="0,0,10,0"
                        HorizontalAlignment="Left">
               <TextBlock Margin="0,10,0,0"
                          FontSize="10"
                          Foreground="{DynamicResource _secondaryTextBrush}"
                          Text="Creator"/>
               <TextBlock Margin="0,0,0,10"
                          Foreground="{DynamicResource _primaryTextBrush}"
                          Text="{Binding Creator}"
                          TextWrapping="Wrap"/>
            </StackPanel>
         </WrapPanel>

         <StackPanel Margin="0,0,15,0"
                     HorizontalAlignment="Left">
            <TextBlock Margin="0,10,0,0"
                       FontSize="10"
                       Foreground="{DynamicResource _secondaryTextBrush}"
                       Text="Description"/>
            <TextBlock Margin="0,0,0,10"
                       Foreground="{DynamicResource _primaryTextBrush}"
                       Text="{Binding Description}"
                       TextWrapping="Wrap"/>
         </StackPanel>

         <StackPanel Margin="0,0,15,0"
                     HorizontalAlignment="Left">
            <TextBlock Margin="0,15,0,10"
                       FontWeight="Bold"
                       Foreground="{DynamicResource _primaryTextBrush}"
                       Text="Rooms"
                       TextTrimming="CharacterEllipsis"/>

            <ItemsControl ItemsSource="{Binding Rooms}">
               <ItemsControl.Style>
                  <Style TargetType="ItemsControl">
                     <Style.Triggers>
                        <DataTrigger Binding="{Binding Rooms.Count}"
                                     Value="0">
                           <Setter Property="Visibility"
                                   Value="Collapsed"/>
                        </DataTrigger>
                     </Style.Triggers>
                  </Style>
               </ItemsControl.Style>

               <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type ovm:RoomViewModel}">
                     <ContentControl Content="{Binding}"
                                     ContentTemplate="{StaticResource _locationRoomDetailsTemplate}"/>
                  </DataTemplate>
               </ItemsControl.ItemTemplate>
            </ItemsControl>
         </StackPanel>
      </StackPanel>
   </DataTemplate>
</ResourceDictionary>