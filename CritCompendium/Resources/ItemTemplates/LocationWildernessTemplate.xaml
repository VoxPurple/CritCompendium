<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ovm="clr-namespace:CritCompendium.ViewModels.ObjectViewModels">
   <ResourceDictionary.MergedDictionaries>
      <ResourceDictionary Source="LocationBuildingTemplate.xaml"/>
   </ResourceDictionary.MergedDictionaries>

   <DataTemplate x:Key="_locationWildernessDetailsTemplate"
                 DataType="{x:Type ovm:LocationViewModel}">
      <StackPanel>
         <WrapPanel>
            <StackPanel Width="225"
                        Margin="0,0,10,0"
                        HorizontalAlignment="Left">
               <TextBlock Margin="0,10,0,0"
                          FontSize="10"
                          Foreground="{DynamicResource _secondaryTextBrush}"
                          Text="Location Type"/>
               <TextBlock Margin="0,0,0,10"
                          Foreground="{DynamicResource _primaryTextBrush}"
                          Text="{Binding LocationType}"
                          TextWrapping="Wrap"/>
            </StackPanel>
         </WrapPanel>

         <StackPanel Margin="0,0,15,0"
                     HorizontalAlignment="Left">
            <TextBlock Margin="0,10,0,0"
                       FontSize="10"
                       Foreground="{DynamicResource _secondaryTextBrush}"
                       Text="Description"/>
            <TextBlock Margin="0,0,0,10"
                       Foreground="{DynamicResource _primaryTextBrush}"
                       Text="{Binding Description}"
                       TextWrapping="Wrap"/>
         </StackPanel>
         <WrapPanel>
            <StackPanel Width="225"
                        Margin="0,0,10,0"
                        HorizontalAlignment="Left">
               <!-- Environment -->
               <TextBlock Margin="0,10,0,0"
                          FontSize="10"
                          Foreground="{DynamicResource _secondaryTextBrush}"
                          Text="Environment"/>
               <TextBlock Margin="0,0,0,10"
                          Foreground="{DynamicResource _primaryTextBrush}"
                          Text="{Binding Environment}"
                          TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel Width="225"
                        Margin="0,0,10,0"
                        HorizontalAlignment="Left">
               <!-- Weather -->
               <TextBlock Margin="0,10,0,0"
                          FontSize="10"
                          Foreground="{DynamicResource _secondaryTextBrush}"
                          Text="Weather"/>
               <TextBlock Margin="0,0,0,10"
                          Foreground="{DynamicResource _primaryTextBrush}"
                          Text="{Binding Weather}"
                          TextWrapping="Wrap"/>
            </StackPanel>
         </WrapPanel>

         <StackPanel>
            <!-- Food & Water -->
            <TextBlock Margin="0,10,0,0"
                       FontSize="10"
                       Foreground="{DynamicResource _secondaryTextBrush}"
                       Text="Food &amp; Water"/>
            <TextBlock Margin="0,0,0,10"
                       Foreground="{DynamicResource _primaryTextBrush}"
                       Text="{Binding FoodAndWater}"
                       TextWrapping="Wrap"/>
         </StackPanel>

         <StackPanel>
            <!-- Landmarks -->
            <TextBlock Margin="0,10,0,0"
                       FontSize="10"
                       Foreground="{DynamicResource _secondaryTextBrush}"
                       Text="Landmarks"/>
            <TextBlock Margin="0,0,0,10"
                       Foreground="{DynamicResource _primaryTextBrush}"
                       Text="{Binding Landmarks}"
                       TextWrapping="Wrap"/>
         </StackPanel>

         <StackPanel>
            <!-- Hazards -->
            <TextBlock Margin="0,10,0,0"
                       FontSize="10"
                       Foreground="{DynamicResource _secondaryTextBrush}"
                       Text="Hazards"/>
            <TextBlock Margin="0,0,0,10"
                       Foreground="{DynamicResource _primaryTextBrush}"
                       Text="{Binding Hazards}"
                       TextWrapping="Wrap"/>
         </StackPanel>

         <StackPanel>
            <!-- Buildings -->
            <TextBlock Margin="0,10,0,0"
                       FontSize="10"
                       Foreground="{DynamicResource _secondaryTextBrush}"
                       Text="Buildings"/>
            <!-- TODO list all buildings in Expander -->

         </StackPanel>

         <StackPanel>
            <!-- Settlements -->
            <TextBlock Margin="0,10,0,0"
                       FontSize="10"
                       Foreground="{DynamicResource _secondaryTextBrush}"
                       Text="Settlements"/>
            <!-- TODO list all settlements in Expander -->
         </StackPanel>

         <StackPanel>
            <!-- Dungeons -->

            <TextBlock Margin="0,10,0,0"
                       FontSize="10"
                       Foreground="{DynamicResource _secondaryTextBrush}"
                       Text="Weather"/>
            <!-- TODO list all dungeons in Expander -->
         </StackPanel>
      </StackPanel>
   </DataTemplate>
</ResourceDictionary>