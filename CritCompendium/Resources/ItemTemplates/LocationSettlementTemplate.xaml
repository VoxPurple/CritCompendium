<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ovm="clr-namespace:CritCompendium.ViewModels.ObjectViewModels">
   <ResourceDictionary.MergedDictionaries>
      <ResourceDictionary Source="LocationBuildingTemplate.xaml"/>
   </ResourceDictionary.MergedDictionaries>

   <DataTemplate x:Key="_locationSettlementDetailsTemplate"
                 DataType="{x:Type ovm:LocationViewModel}">
      <StackPanel>
         <StackPanel Width="225"
                     Margin="0,0,10,0"
                     HorizontalAlignment="Left">
            <TextBlock Margin="0,10,0,0"
                       FontSize="10"
                       Foreground="{DynamicResource _secondaryTextBrush}"
                       Text="Location Type"/>
            <TextBlock Margin="0,0,0,10"
                       Foreground="{DynamicResource _primaryTextBrush}"
                       Text="{Binding LocationType}"
                       TextWrapping="Wrap"/>
         </StackPanel>

         <WrapPanel>
            <StackPanel Width="225"
                        Margin="0,0,10,0"
                        HorizontalAlignment="Left">
               <TextBlock Text="Leader"
                          Margin="0,10,0,0"
                          FontSize="10"
                          Foreground="{DynamicResource _secondaryTextBrush}"/>
               <TextBlock Text="{Binding RulerNotes}"
                          Margin="0,0,0,10"
                          Foreground="{DynamicResource _primaryTextBrush}"
                          TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Width="225"
                        Margin="0,0,10,0"
                        HorizontalAlignment="Left">
               <TextBlock Text="Town Traits"
                          Margin="0,10,0,0"
                          FontSize="10"
                          Foreground="{DynamicResource _secondaryTextBrush}"/>
               <TextBlock Text="{Binding Traits}"
                          Margin="0,0,0,10"
                          FontSize="10"
                          Foreground="{DynamicResource _primaryTextBrush}"/>
            </StackPanel>
         </WrapPanel>

         <WrapPanel>
            <StackPanel Width="225"
                        Margin="0,0,10,0"
                        HorizontalAlignment="Left">
               <!-- Known For -->
               <TextBlock Margin="0,10,0,0"
                          FontSize="10"
                          Foreground="{DynamicResource _secondaryTextBrush}"
                          Text="Known For"/>
               <TextBlock Margin="0,0,0,10"
                          FontSize="10"
                          Foreground="{DynamicResource _primaryTextBrush}"
                          Text="{Binding KnownFor}"
                          TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel Width="225"
                        Margin="0,0,10,0"
                        HorizontalAlignment="Left">
               <!-- Known Conflicts -->
               <TextBlock Margin="0,10,0,0"
                          FontSize="10"
                          Foreground="{DynamicResource _secondaryTextBrush}"
                          Text="Known Conflicts"/>
               <TextBlock Margin="0,0,0,10"
                          FontSize="10"
                          Foreground="{DynamicResource _primaryTextBrush}"
                          Text="{Binding Conflicts}"
                          TextWrapping="Wrap"/>
            </StackPanel>

            <!-- TODO - Notable NPCs -->
            <!-- <StackPanel> -->
               <!-- Notable NPCs -->
               <!-- <TextBlock Margin="0,10,0,0" -->
                          <!-- FontSize="10" -->
                          <!-- Foreground="{DynamicResource _secondaryTextBrush}" -->
                          <!-- Text="Notable NPCs"/> -->
               <!-- TODO list all notable NPCs in Expander -->
            <!-- </StackPanel> -->
         </WrapPanel>

         <StackPanel Margin="0,0,15,0"
                     HorizontalAlignment="Left">
            <TextBlock Margin="0,10,0,0"
                       FontSize="10"
                       Foreground="{DynamicResource _secondaryTextBrush}"
                       Text="Description"/>
            <TextBlock Margin="0,0,0,10"
                       Foreground="{DynamicResource _primaryTextBrush}"
                       Text="{Binding Description}"
                       TextWrapping="Wrap"/>
         </StackPanel>

         <!-- Buildings -->
         <Expander>
            <Expander.Header>
               <TextBlock Margin="0,0,0,0"
                          FontWeight="Bold"
                          Foreground="{DynamicResource _primaryTextBrush}"
                          Text="Buildings"
                          TextTrimming="CharacterEllipsis"/>
            </Expander.Header>
            <StackPanel Margin="25,0,0,0">
               <ItemsControl ItemsSource="{Binding Buildings}">
                  <ItemsControl.Style>
                     <Style TargetType="ItemsControl">
                        <Style.Triggers>
                           <DataTrigger Binding="{Binding Buildings.Count}"
                                        Value="0">
                              <Setter Property="Visibility"
                                      Value="Collapsed"/>
                           </DataTrigger>
                        </Style.Triggers>
                     </Style>
                  </ItemsControl.Style>

                  <ItemsControl.ItemTemplate>
                     <DataTemplate DataType="{x:Type ovm:BuildingViewModel}">
                        <ContentControl Content="{Binding}"
                                        ContentTemplate="{StaticResource _locationBuildingDetailsTemplate}"/>
                     </DataTemplate>
                  </ItemsControl.ItemTemplate>
               </ItemsControl>
            </StackPanel>
         </Expander>
      </StackPanel>
   </DataTemplate>
</ResourceDictionary>