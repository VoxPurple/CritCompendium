<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ovm="clr-namespace:CritCompendium.ViewModels.ObjectViewModels">
    <DataTemplate x:Key="_locationRoomDetailsTemplate"
                  DataType="{x:Type ovm:RoomViewModel}">
        <Expander Margin="0,0,0,15">
            <Expander.Header>
                <TextBlock Foreground="{DynamicResource _primaryTextBrush}"
                           Text="{Binding Name}"
                           TextWrapping="Wrap"
                           FontWeight="Bold"/>
            </Expander.Header>
            <StackPanel Margin="25,0,0,0">
                <StackPanel>
                    <TextBlock Margin="0,5,0,0"
                               Foreground="{DynamicResource _secondaryTextBrush}"
                               Text="Room Description"
                               FontSize="10"/>
                    <TextBlock Margin="0,5,0,0"
                               Foreground="{DynamicResource _primaryTextBrush}"
                               Text="{Binding Description}"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <WrapPanel>
                    <StackPanel>
                        <TextBlock Width="225"
                                   Margin="0,10,0,0"
                                   FontSize="10"
                                   Foreground="{DynamicResource _secondaryTextBrush}"
                                   Text="Entrance"/>
                        <TextBlock Margin="0,5,0,0"
                                   Foreground="{DynamicResource _primaryTextBrush}"
                                   Text="{Binding Entry}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Width="225"
                                   Margin="0,10,0,0"
                                   FontSize="10"
                                   Foreground="{DynamicResource _secondaryTextBrush}"
                                   Text="Floor"/>
                        <TextBlock Margin="0,5,0,0"
                                   Foreground="{DynamicResource _primaryTextBrush}"
                                   Text="{Binding Floor}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </WrapPanel>
            </StackPanel>
        </Expander>
    </DataTemplate>
    <DataTemplate x:Key="_locationBuildingDetailsTemplate"
                  DataType="{x:Type ovm:BuildingViewModel}">
        <Expander>
            <Expander.Header>
                <TextBlock Foreground="{DynamicResource _primaryTextBrush}"
                           Text="{Binding Name}"
                           TextWrapping="Wrap"
                           FontWeight="Bold"/>
            </Expander.Header>
            <StackPanel Margin="50,0,0,0">
                <WrapPanel>
                    <StackPanel Width="225"
                                Margin="0,0,10,0"
                                HorizontalAlignment="Left">
                        <TextBlock Margin="0,10,0,0"
                                   FontSize="10"
                                   Foreground="{DynamicResource _secondaryTextBrush}"
                                   Text="Type"/>
                        <TextBlock Margin="0,5,0,0"
                                   Foreground="{DynamicResource _primaryTextBrush}"
                                   Text="{Binding Type}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Width="225"
                                Margin="0,0,10,0"
                                HorizontalAlignment="Left">
                        <TextBlock Margin="15,10,0,0"
                                   Foreground="{DynamicResource _secondaryTextBrush}"
                                   Text="Description"
                                   FontSize="10"/>
                        <TextBlock Margin="15,5,0,0"
                                   Foreground="{DynamicResource _primaryTextBrush}"
                                   Text="{Binding Description}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </WrapPanel>

                <StackPanel Margin="0,0,15,0"
                            HorizontalAlignment="Left">
                    <Expander>
                        <Expander.Header>
                            <TextBlock Margin="0,10,0,10"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource _primaryTextBrush}"
                                       Text="Rooms"
                                       TextTrimming="CharacterEllipsis"/>
                        </Expander.Header>
                        <ItemsControl ItemsSource="{Binding Rooms}">
                            <ItemsControl.Style>
                                <Style TargetType="ItemsControl">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Rooms.Count}"
                                                     Value="0">
                                            <Setter Property="Visibility"
                                                    Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.Style>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type ovm:RoomViewModel}">
                                    <ContentControl Content="{Binding}"
                                                    ContentTemplate="{StaticResource _locationRoomDetailsTemplate}"
                                                    Margin="50,0,0,0"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>
                </StackPanel>
            </StackPanel>
        </Expander>
    </DataTemplate>
</ResourceDictionary>